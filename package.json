{
  "name": "dsh-mcp-bridge",
  "version": "0.1.0",
  "private": true,
  "description": "MCP server that exposes DeepSeek Harness as an execution subagent through the official dsh SDK profile.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "dsh-mcp-bridge": "src/server.mjs"
  },
  "scripts": {
    "start": "node src/server.mjs",
    "test": "node --test test/run-state.test.mjs test/manager.test.mjs test/status-publisher.test.mjs test/installer.test.mjs plugins/dsh-run-monitor/test/host.test.mjs plugins/dsh-run-monitor/test/client.test.mjs",
    "test:plugin": "node --test plugins/dsh-run-monitor/test/host.test.mjs plugins/dsh-run-monitor/test/client.test.mjs",
    "test:smoke": "node test/smoke.mjs",
    "test:e2e": "node test/e2e-live.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^3.25.76"
  }
}
